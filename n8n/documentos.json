    {
      "parameters": {
        "jsCode": "// Resposta automatica, sem passar pela Ana (nao gasta o limite do Groq): o que chegou e o que ainda falta.\nconst r = $('Rotular documento').first().json;\nconst nomes = { cnh_rg: 'a CNH ou RG', comprovante_residencia: 'o comprovante de residência', imposto_renda: 'a declaração de imposto de renda', certidao_nascimento: 'a certidão', renda: 'o comprovante de renda', extrato: 'o extrato bancário' };\nconst resp = $json || {};\nconst faltam = (typeof resp === 'string' ? resp : (resp.data !== undefined ? resp.data : (resp.body !== undefined ? resp.body : ''))) || '';\nlet output;\nif (r.tipo === 'outro') output = 'Recebi o arquivo! Me diz qual documento é esse: CNH ou RG, comprovante de residência, imposto de renda, certidão de nascimento, comprovante de renda ou extrato bancário?';\nelse if (faltam) output = 'Recebi ' + nomes[r.tipo] + '! Ainda faltam: ' + faltam + '. Pode mandar o próximo por aqui mesmo.';\nelse output = 'Recebi ' + nomes[r.tipo] + '! Agora está tudo aqui, obrigada. Já deixo com o corretor para a pré análise.';\nreturn [{ json: { output, telefone: r.telefone, nome_whatsapp: r.nome_whatsapp } }];"
      },
