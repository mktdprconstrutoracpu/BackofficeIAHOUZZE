    {
      "parameters": {
        "jsCode": "// Decide o tipo do documento: pela legenda que veio com o arquivo, senao pelo que a Ana pediu por ultimo, senao \"outro\".\nconst d = $('Dados do arquivo').first().json;\nconst conv = $json || {};\nconst leg = (d.legenda || '').toLowerCase();\nconst regras = [\n  ['cnh_rg', /\\b(cnh|rg|identidade|habilita)/],\n  ['comprovante_residencia', /resid|endere|conta de (luz|agua|água|gas|gás)|enel|sabesp|aluguel/],\n  ['imposto_renda', /imposto|\\bir\\b|irpf|declara/],\n  ['certidao_nascimento', /certid|nascimento|casamento/],\n  ['renda', /renda|holerite|contracheque|pagamento|salario|salário|carteira/],\n  ['extrato', /extrato|banc/],\n];\nlet tipo = 'outro';\nfor (const [t, re] of regras) if (re.test(leg)) { tipo = t; break; }\nif (tipo === 'outro' && conv.documento_esperado) tipo = conv.documento_esperado;\nconst mime = d.mime || '';\nconst ext = mime.includes('pdf') ? 'pdf' : mime.includes('png') ? 'png' : mime.includes('webp') ? 'webp' : 'jpg';\nconst caminho = d.telefone + '/' + Date.now() + '-' + tipo + '.' + ext;\nreturn [{ json: Object.assign({}, d, { tipo, ext, caminho, pausada: conv.pausada === true }) }];"
      },
