  "agente_texto": "={{ (() => { const ex = [['cnh_rg','CNH ou RG'],['comprovante_residencia','comprovante de residência'],['imposto_renda','declaração de imposto de renda'],['certidao_nascimento','certidão de nascimento ou casamento'],['renda','comprovante de renda formal'],['extrato','extrato bancário dos últimos 6 meses']]; const r = $('Documentos da pessoa').first().json || {}; const rec = Array.isArray(r.tipos) ? r.tipos : []; const semTipo = Number(r.sem_tipo) || 0; if (!rec.length && !semTipo) return $('Dados').first().json.chatInput; const tem = ex.filter(e => rec.includes(e[0])).map(e => e[1]); const falta = ex.filter(e => !rec.includes(e[0])).map(e => e[1]); return 'Documentos desta pessoa já recebidos: ' + (tem.join(', ') || 'nenhum') + (semTipo ? ' (e ' + semTipo + ' arquivo(s) que ela não disse o que é: pergunte qual documento é)' : '') + '. Ainda faltam: ' + (falta.length ? falta.join(', ') : 'nenhum, está completo') + '.\\n\\n' + $('Dados').first().json.chatInput; })() }}",
