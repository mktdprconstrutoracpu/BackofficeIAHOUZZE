        "jsCode": "// Decide quem recebe o aviso e monta os parametros do modelo (template) da Meta.\n// Ordem: o corretor que assumiu a conversa (se tiver WhatsApp em ia_liberacoes) > gerentes com WhatsApp > whatsapp_padrao do no \"Evento\".\nconst ev = $('Evento').first().json;\nconst d = ev.dados || {};\nconst pessoas = $('Quem pode receber').all().map(i => i.json).filter(p => p && p.email);\nconst conversa = ($('Conversa do cliente').first() || {}).json || {};\nconst digitos = v => String(v || '').replace(/\\D/g, '');\nconst limpo = (v, max) => String(v == null ? '' : v).replace(/\\s+/g, ' ').trim().slice(0, max) || '-';\nfunction fmtTel(t) { const s = digitos(t); return s.length === 13 && s.startsWith('55') ? '(' + s.slice(2, 4) + ') ' + s.slice(4, 9) + '-' + s.slice(9) : (s ? '+' + s : '-'); }\nfunction dataBr(iso) { const m = String(iso || '').match(/^(\\d{4})-(\\d{2})-(\\d{2})/); return m ? m[3] + '/' + m[2] + '/' + m[1] : ''; }\nlet destinos = [];\nconst dono = conversa.corretor_email ? pessoas.find(p => String(p.email).toLowerCase() === String(conversa.corretor_email).toLowerCase()) : null;\nif (dono && digitos(dono.whatsapp)) destinos = [digitos(dono.whatsapp)];\nif (!destinos.length) destinos = pessoas.filter(p => p.papel === 'gerente' && digitos(p.whatsapp)).map(p => digitos(p.whatsapp));\nif (!destinos.length && digitos(ev.whatsapp_padrao)) destinos = [digitos(ev.whatsapp_padrao)];\ndestinos = [...new Set(destinos)];\nif (!destinos.length) return [{ json: { to: '', motivo: 'sem destinatario: cadastre o whatsapp em ia_liberacoes ou preencha whatsapp_padrao no no Evento' } }];\nlet modelo, parametros;\nif (ev.tipo === 'pediu_humano') {\n  modelo = 'houzze_pediu_humano';\n  parametros = [limpo(d.nome || conversa.nome_whatsapp, 60), fmtTel(d.telefone || ev.telefone), limpo(d.ultima_mensagem, 200)];\n} else {\n  modelo = 'houzze_novo_lead';\n  const visita = d.visita_dia ? dataBr(d.visita_dia) + (d.visita_periodo ? ' de ' + d.visita_periodo : '') : 'sem visita marcada';\n  parametros = [limpo(d.nome, 60), fmtTel(d.telefone || ev.telefone), limpo([d.interesse, d.unidade ? 'unidade ' + d.unidade : ''].filter(Boolean).join(', '), 80), limpo(visita, 60)];\n}\nreturn destinos.map(to => ({ json: { to, modelo, parametros, tipo: ev.tipo } }));"
      },
