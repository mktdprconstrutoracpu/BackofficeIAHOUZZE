      "parameters": {
        "jsCode": "// O que a equipe mexeu no backoffice vira linha da aba Leads (as mesmas colunas que a Ana escreve).\nconst d = $('Evento').first().json.dados || {};\nfunction dataBr(iso) { const m = String(iso || '').match(/^(\\d{4})-(\\d{2})-(\\d{2})/); return m ? m[3] + '/' + m[2] + '/' + m[1] : ''; }\nconst status = d.status_corretor || '';\nreturn [{ json: {\n  chave: d.chave || '',\n  data_hora: d.data_hora_texto || '',\n  status: status + (d.observacao ? ' - ' + String(d.observacao).replace(/\\s+/g, ' ').trim().slice(0, 80) : ''),\n  visita_dia: dataBr(d.visita_dia),\n  visita_periodo: d.visita_periodo || ''\n} }];"
      },
